%%SELECTOR%% {
  width: {{ design.container.width.style }};
  height: {{ design.container.height.style }};
  {{ macros.backgroundColor(design.container.background) }}
  {{ macros.borders(design.container.borders) }}
  {{ macros.spacing_padding_all(design.container.padding) }}
  {{ macros.typography(design.typography, globalSettings)  }}
  {{ macros.spacing_margin_y(design.spacing) }}
}

{# ---- Barvy a zvýraznění: !important, aby přebily barvy z nastavení projektu (inline styl) ---- #}
%%SELECTOR%% .martin-dv {
  {% if design.barvy.akcent %}--martin-dv-accent: {{ design.barvy.akcent }} !important;{% endif %}
  {% if design.barvy.rezervovany %}--martin-dv-reserved: {{ design.barvy.rezervovany }} !important;{% endif %}
  {% if design.barvy.prodany %}--martin-dv-sold: {{ design.barvy.prodany }} !important;{% endif %}
  {% if design.barvy.text %}color: {{ design.barvy.text }};{% endif %}
  {% if design.tabulka.ramecek %}--martin-dv-line: {{ design.tabulka.ramecek }} !important;{% endif %}
  {% if design.oblasti.barva %}--martin-dv-hl: {{ design.oblasti.barva }};{% endif %}
  {% if design.oblasti.pruhlednost is defined and design.oblasti.pruhlednost is not null and design.oblasti.pruhlednost != '' %}--martin-dv-hl-opacity: {{ design.oblasti.pruhlednost / 100 }};{% endif %}
  {% if design.oblasti.obrys %}--martin-dv-hl-stroke: {{ design.oblasti.obrys }};{% endif %}
  {% if design.oblasti.obrys_sirka.style %}--martin-dv-hl-stroke-width: {{ design.oblasti.obrys_sirka.style }};{% endif %}
  {% if design.oblasti.jednotky_pruhlednost is defined and design.oblasti.jednotky_pruhlednost is not null and design.oblasti.jednotky_pruhlednost != '' %}--martin-dv-unit-opacity: {{ design.oblasti.jednotky_pruhlednost / 100 }};{% endif %}
}

{# ---- Úvod projektu ---- #}
%%SELECTOR%% .martin-dv .martin-dv__project-title {
  {{ macros.typography(design.uvod.nazev, globalSettings) }}
}
%%SELECTOR%% .martin-dv .martin-dv__project-desc,
%%SELECTOR%% .martin-dv .martin-dv__project-desc p {
  {{ macros.typography(design.uvod.popis, globalSettings) }}
}
%%SELECTOR%% .martin-dv .martin-dv__intro {
  {% if design.uvod.sirka.style %}max-width: {{ design.uvod.sirka.style }};{% endif %}
  {% if design.uvod.mezera.style %}margin-bottom: {{ design.uvod.mezera.style }};{% endif %}
}

{# ---- Filtr tabulky ---- #}
%%SELECTOR%% .martin-dv .martin-dv__filters {
  {% if design.filtr.box_pozadi %}background: {{ design.filtr.box_pozadi }};{% endif %}
  {% if design.filtr.box_ramecek %}border-color: {{ design.filtr.box_ramecek }};{% endif %}
  {% if design.filtr.box_zaobleni.style %}border-radius: {{ design.filtr.box_zaobleni.style }};{% endif %}
}
%%SELECTOR%% .martin-dv .martin-dv__fpill {
  {{ macros.typography(design.filtr.tlacitko, globalSettings) }}
  {% if design.filtr.pozadi %}background: {{ design.filtr.pozadi }};{% endif %}
  {% if design.filtr.ramecek %}border-color: {{ design.filtr.ramecek }};{% endif %}
  {% if design.filtr.zaobleni.style %}border-radius: {{ design.filtr.zaobleni.style }};{% endif %}
}
%%SELECTOR%% .martin-dv .martin-dv__fpill.is-active {
  {% if design.filtr.aktivni_pozadi %}background: {{ design.filtr.aktivni_pozadi }}; border-color: {{ design.filtr.aktivni_pozadi }};{% endif %}
  {% if design.filtr.aktivni_text %}color: {{ design.filtr.aktivni_text }};{% endif %}
}

{# ---- Nadpisy ---- #}
%%SELECTOR%% .martin-dv .martin-dv__title {
  {{ macros.typography(design.nadpisy.panel, globalSettings) }}
}
%%SELECTOR%% .martin-dv .martin-dv__table-title {
  {{ macros.typography(design.nadpisy.tabulka, globalSettings) }}
}

{# ---- Seznam vedle obrázku ---- #}
%%SELECTOR%% .martin-dv .martin-dv__side > .martin-dv__hint {
  {{ macros.typography(design.seznam.napoveda, globalSettings) }}
}
%%SELECTOR%% .martin-dv a.martin-dv__target {
  {% if design.seznam.pozadi %}background: {{ design.seznam.pozadi }};{% endif %}
  {% if design.seznam.ramecek %}border-color: {{ design.seznam.ramecek }};{% endif %}
  {% if design.seznam.zaobleni.style %}border-radius: {{ design.seznam.zaobleni.style }};{% endif %}
}
%%SELECTOR%% .martin-dv a.martin-dv__target.is-hover,
%%SELECTOR%% .martin-dv a.martin-dv__target:focus-visible {
  {% if design.seznam.pozadi_hover %}background: {{ design.seznam.pozadi_hover }};{% endif %}
  {% if design.seznam.ramecek_hover %}border-color: {{ design.seznam.ramecek_hover }};{% endif %}
}
%%SELECTOR%% .martin-dv a.martin-dv__target strong {
  {{ macros.typography(design.seznam.nazev, globalSettings) }}
}
%%SELECTOR%% .martin-dv a.martin-dv__target small {
  {{ macros.typography(design.seznam.popis, globalSettings) }}
}

{# ---- Tlačítka podlaží a Zpět ---- #}
%%SELECTOR%% .martin-dv .martin-dv__back,
%%SELECTOR%% .martin-dv .martin-dv__pill {
  {% if design.tlacitka.pozadi %}background: {{ design.tlacitka.pozadi }};{% endif %}
  {% if design.tlacitka.text %}color: {{ design.tlacitka.text }};{% endif %}
  {% if design.tlacitka.ramecek %}border-color: {{ design.tlacitka.ramecek }};{% endif %}
}
%%SELECTOR%% .martin-dv .martin-dv__pill.is-active {
  {% if design.tlacitka.aktivni_pozadi %}background: {{ design.tlacitka.aktivni_pozadi }}; border-color: {{ design.tlacitka.aktivni_pozadi }};{% endif %}
  {% if design.tlacitka.aktivni_text %}color: {{ design.tlacitka.aktivni_text }};{% endif %}
}

{# ---- Karta jednotky / podlaží ---- #}
%%SELECTOR%% .martin-dv .martin-dv__card {
  {% if design.karta.pozadi %}background: {{ design.karta.pozadi }};{% endif %}
  {% if design.karta.ramecek %}border-color: {{ design.karta.ramecek }};{% endif %}
  {% if design.karta.zaobleni.style %}border-radius: {{ design.karta.zaobleni.style }};{% endif %}
}
%%SELECTOR%% .martin-dv .martin-dv__card .martin-dv__kicker,
%%SELECTOR%% .martin-dv .martin-dv__card .martin-dv__acc-title {
  {{ macros.typography(design.karta.popisek, globalSettings) }}
}
%%SELECTOR%% .martin-dv .martin-dv__card-title {
  {{ macros.typography(design.karta.nadpis, globalSettings) }}
}
%%SELECTOR%% .martin-dv .martin-dv__card p:not(.martin-dv__kicker):not(.martin-dv__acc-title),
%%SELECTOR%% .martin-dv .martin-dv__card .martin-dv__dl {
  {{ macros.typography(design.karta.text, globalSettings) }}
}
%%SELECTOR%% .martin-dv a.martin-dv__btn {
  {% if design.karta.tlacitko_pozadi %}background: {{ design.karta.tlacitko_pozadi }};{% endif %}
  {% if design.karta.tlacitko_text %}color: {{ design.karta.tlacitko_text }};{% endif %}
}

{# ---- Bublina ---- #}
%%SELECTOR%% .martin-dv .martin-dv__tip {
  {% if design.bublina.pozadi %}background: {{ design.bublina.pozadi }};{% endif %}
  {% if design.bublina.text %}color: {{ design.bublina.text }};{% endif %}
  {% if design.bublina.ramecek %}border: 1px solid {{ design.bublina.ramecek }};{% endif %}
  {% if design.bublina.zaobleni.style %}border-radius: {{ design.bublina.zaobleni.style }};{% endif %}
}

{# ---- Štítky stavu (tabulka, karta, bublina) ---- #}
%%SELECTOR%% .martin-dv .martin-dv__status[data-status="volny"] {
  {% if design.stavy.volny_pozadi %}background: {{ design.stavy.volny_pozadi }};{% endif %}
  {% if design.stavy.volny_text %}color: {{ design.stavy.volny_text }};{% endif %}
}
%%SELECTOR%% .martin-dv .martin-dv__status[data-status="rezervovany"] {
  {% if design.stavy.rezervovany_pozadi %}background: {{ design.stavy.rezervovany_pozadi }};{% endif %}
  {% if design.stavy.rezervovany_text %}color: {{ design.stavy.rezervovany_text }};{% endif %}
}
%%SELECTOR%% .martin-dv .martin-dv__status[data-status="prodany"] {
  {% if design.stavy.prodany_pozadi %}background: {{ design.stavy.prodany_pozadi }};{% endif %}
  {% if design.stavy.prodany_text %}color: {{ design.stavy.prodany_text }};{% endif %}
}

{# ---- Legenda stavů ---- #}
%%SELECTOR%% .martin-dv .martin-dv__legend {
  {{ macros.typography(design.legenda.text, globalSettings) }}
}
%%SELECTOR%% .martin-dv .martin-dv__legend i {
  {% if design.legenda.ctverec.style %}width: {{ design.legenda.ctverec.style }}; height: {{ design.legenda.ctverec.style }};{% endif %}
  {% if design.legenda.zaobleni.style %}border-radius: {{ design.legenda.zaobleni.style }};{% endif %}
}

%%SELECTOR%% .martin-dv .martin-dv__tip .martin-dv__tip-price {
  {{ macros.typography(design.bublina.cena, globalSettings) }}
}

{# ---- Tabulka ---- #}
%%SELECTOR%% .martin-dv .martin-dv__table th {
  {{ macros.typography(design.tabulka.hlavicka, globalSettings) }}
  {% if design.tabulka.hlavicka_pozadi %}background: {{ design.tabulka.hlavicka_pozadi }};{% endif %}
}
%%SELECTOR%% .martin-dv .martin-dv__table td {
  {{ macros.typography(design.tabulka.bunky, globalSettings) }}
}
%%SELECTOR%% .martin-dv .martin-dv__table .martin-dv__cell-name,
%%SELECTOR%% .martin-dv .martin-dv__table .martin-dv__cell-name a {
  {{ macros.typography(design.tabulka.jednotka, globalSettings) }}
}
%%SELECTOR%% .martin-dv .martin-dv__table .martin-dv__cell-name a:hover,
%%SELECTOR%% .martin-dv .martin-dv__table .martin-dv__cell-name a:focus-visible {
  {% if design.tabulka.jednotka_hover %}color: {{ design.tabulka.jednotka_hover }};{% endif %}
}
%%SELECTOR%% .martin-dv .martin-dv__table tbody tr.is-hover {
  {% if design.tabulka.radek_hover %}background: {{ design.tabulka.radek_hover }};{% endif %}
}
